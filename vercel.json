{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)content' ':(exclude)public/media'",
  "functions": {
    "api/content.ts": { "includeFiles": "content/**" },
    "api/theory.ts": { "includeFiles": "content/**" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/t/:slug", "destination": "/api/theory?slug=:slug" },
    { "source": "/media/:path*", "destination": "/api/media?path=:path*" }
  ]
}
